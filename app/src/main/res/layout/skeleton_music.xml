<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/music_background">

    <!-- Weather Header Skeleton -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/skeletonWeatherHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/weather_header_background"
        android:padding="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Location Skeleton -->
        <View
            android:id="@+id/skeletonLocation"
            android:layout_width="@dimen/dp_200"
            android:layout_height="@dimen/dp_22"
            android:layout_marginEnd="@dimen/dp_12"
            android:background="@drawable/skeleton_shimmer_item"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Temperature Layout Skeleton -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/skeletonTemperatureLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:paddingHorizontal="@dimen/dp_6"
            app:layout_constraintTop_toBottomOf="@+id/skeletonLocation">

            <!-- Temperature Skeleton -->
            <View
                android:id="@+id/skeletonTemperature"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_56"
                android:background="@drawable/skeleton_shimmer_item"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Weather Icon Skeleton -->
            <View
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_60"
                android:layout_marginStart="@dimen/dp_8"
                android:background="@drawable/skeleton_shimmer_item"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/skeletonTemperature"
                app:layout_constraintBottom_toBottomOf="@+id/skeletonTemperature" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Tabs Skeleton -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/skeletonTemperatureLayout">

            <!-- Tab 1 Skeleton -->
            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_40"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dp_10"
                android:background="@drawable/skeleton_shimmer_item" />

            <!-- Tab 2 Skeleton -->
            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_40"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dp_10"
                android:background="@drawable/skeleton_shimmer_item" />

            <!-- Tab 3 Skeleton -->
            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_40"
                android:layout_weight="1"
                android:background="@drawable/skeleton_shimmer_item" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content Area Skeleton -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:background="#F6EDFF"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingTop="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skeletonWeatherHeader">

        <!-- Title Skeleton -->
        <View
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_18"
            android:layout_marginBottom="@dimen/dp_12"
            android:background="@drawable/skeleton_shimmer_item" />

        <!-- Items Skeleton -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Item 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:orientation="horizontal"
                android:padding="@dimen/dp_8"
                android:background="@drawable/bg_song_item">

                <View
                    android:layout_width="@dimen/dp_76"
                    android:layout_height="@dimen/dp_76"
                    android:background="@drawable/skeleton_shimmer_item" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginVertical="@dimen/dp_16"
                    android:orientation="vertical">

                    <View
                        android:layout_width="@dimen/dp_150"
                        android:layout_height="@dimen/dp_18"
                        android:layout_marginBottom="@dimen/dp_4"
                        android:background="@drawable/skeleton_shimmer_item" />

                    <View
                        android:layout_width="@dimen/dp_200"
                        android:layout_height="@dimen/dp_18"
                        android:background="@drawable/skeleton_shimmer_item" />

                </LinearLayout>

            </LinearLayout>

            <!-- Item 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:orientation="horizontal"
                android:padding="@dimen/dp_8"
                android:background="@drawable/bg_song_item">

                <View
                    android:layout_width="@dimen/dp_76"
                    android:layout_height="@dimen/dp_76"
                    android:background="@drawable/skeleton_shimmer_item" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginVertical="@dimen/dp_16"
                    android:orientation="vertical">

                    <View
                        android:layout_width="@dimen/dp_180"
                        android:layout_height="@dimen/dp_18"
                        android:layout_marginBottom="@dimen/dp_4"
                        android:background="@drawable/skeleton_shimmer_item" />

                    <View
                        android:layout_width="@dimen/dp_160"
                        android:layout_height="@dimen/dp_18"
                        android:background="@drawable/skeleton_shimmer_item" />

                </LinearLayout>

            </LinearLayout>

            <!-- Item 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:orientation="horizontal"
                android:padding="@dimen/dp_8"
                android:background="@drawable/bg_song_item">

                <View
                    android:layout_width="@dimen/dp_76"
                    android:layout_height="@dimen/dp_76"
                    android:background="@drawable/skeleton_shimmer_item" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginVertical="@dimen/dp_16"
                    android:orientation="vertical">

                    <View
                        android:layout_width="@dimen/dp_140"
                        android:layout_height="@dimen/dp_18"
                        android:layout_marginBottom="@dimen/dp_4"
                        android:background="@drawable/skeleton_shimmer_item" />

                    <View
                        android:layout_width="@dimen/dp_170"
                        android:layout_height="@dimen/dp_18"
                        android:background="@drawable/skeleton_shimmer_item" />

                </LinearLayout>

            </LinearLayout>

            <!-- Item 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:orientation="horizontal"
                android:padding="@dimen/dp_8"
                android:background="@drawable/bg_song_item">

                <View
                    android:layout_width="@dimen/dp_76"
                    android:layout_height="@dimen/dp_76"
                    android:background="@drawable/skeleton_shimmer_item" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginVertical="@dimen/dp_16"
                    android:orientation="vertical">

                    <View
                        android:layout_width="@dimen/dp_160"
                        android:layout_height="@dimen/dp_18"
                        android:layout_marginBottom="@dimen/dp_4"
                        android:background="@drawable/skeleton_shimmer_item" />

                    <View
                        android:layout_width="@dimen/dp_190"
                        android:layout_height="@dimen/dp_18"
                        android:background="@drawable/skeleton_shimmer_item" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
