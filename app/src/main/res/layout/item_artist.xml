<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_artist_item"
    android:layout_marginBottom="16dp"
    android:layout_marginHorizontal="6dp"
    android:padding="8dp">

    <!-- Artist Image -->
    <ImageView
        android:id="@+id/ivArtist"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_image_placeholder_round"
        android:scaleType="centerCrop"
        android:src="@drawable/iv_artist"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Artist Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/ivArtist"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivArtist"
        app:layout_constraintTop_toTopOf="@+id/ivArtist">

        <TextView
            android:id="@+id/tvArtistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            tools:text="Nghệ sĩ 4" />

        <TextView
            android:id="@+id/tvArtistDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:lineSpacingExtra="1dp"
            tools:text="Thông tin chi tiết nghệ sĩ 4" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout> 