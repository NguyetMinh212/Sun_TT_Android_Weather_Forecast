<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_song_item"
    android:layout_marginBottom="@dimen/dp_16">

    <!-- Song Image -->
    <ImageView
        android:id="@+id/ivSong"
        android:layout_width="@dimen/dp_76"
        android:layout_height="@dimen/dp_76"
        android:background="@drawable/bg_image_placeholder"
        android:scaleType="centerCrop"
        android:src="@drawable/iv_song"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Song Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginVertical="@dimen/dp_16"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/ivSong"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivSong"
        app:layout_constraintTop_toTopOf="@+id/ivSong">

        <TextView
            android:id="@+id/tvSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_18"
            android:textStyle="bold"
            tools:text="Ca khúc 1" />

        <TextView
            android:id="@+id/tvSongArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/sp_18"
            tools:text="Thông tin chi tiết ca khúc 1" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
